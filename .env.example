NODE_ENV=production
PORT=3000
BODYHEAL_ADMIN_PASSCODE=replace-with-a-long-unique-secret-at-least-16-characters
BODYHEAL_ADMIN_DEFAULT_PASSCODE=
DATABASE_URL= # optional; leave empty to use local JSON and file storage
CORS_ORIGINS=https://bodyheal.shop
VITE_BODYHEAL_CONTACT_EMAIL=concierge@bodyheal.shop

# Optional email delivery; bookings and customer access work without these.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BODYHEALING <concierge@bodyheal.shop>
BODYHEAL_ADMIN_ALERT_EMAIL=
